# Token du bot fourni par @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# Ton Chat ID (envoie /start au bot pour l'obtenir)
TELEGRAM_CHAT_ID=987654321

# ── Ollama (IA locale) 
# URL de ton serveur Ollama (par défaut localhost)
OLLAMA_BASE_URL=http://localhost:11434

# Modèle à utiliser (doit être installé: ollama pull <model>)
# Recommandations: llama3.2, mistral, gemma3
OLLAMA_MODEL=llama3.2

# Digest quotidien (défaut: tous les jours à 8h00)
CRON_DAILY=0 8 * * *

# Digest hebdomadaire (défaut: chaque lundi à 10h00)
CRON_WEEKLY=0 10 * * 1

# Timezone (liste: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=Europe/Paris

# Nombre max d'articles par digest
MAX_ITEMS=10

# Langue des résumés IA
DIGEST_LANGUAGE=français

# Active les logs debug (optionnel)
# LOG_LEVEL=debug
